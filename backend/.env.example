# Copy this file to backend/.env to change a setting. In development every setting has a
# working default. In production MONGODB_URI, WEB_ORIGIN and (for first-run setup) SETUP_CODE
# must be set: the server refuses to start, or to be set up, without them.

# NODE_ENV=development

# The port the API listens on. In production, a PORT set by the hosting platform is used when
# API_PORT is not set. In development PORT is ignored (it belongs to the web app's dev server);
# if you change API_PORT, start the web app with API_TARGET=http://localhost:<that port>.
# API_PORT=4200

# Where MongoDB is, and the database this app keeps to. Nothing else in MongoDB is touched.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=delta_hrms

# The address(es) the web app is served from, comma-separated. Requests that change anything
# are accepted only from these.
# WEB_ORIGIN=http://localhost:5174

# How many proxies stand between the browser and this server (a load balancer, nginx, the
# hosting platform's router). The server takes the visitor's address from that many, and from
# no one else: it is what the sign-in limit counts by and what the audit log records. Leave it
# unset when the server is reached directly. Set it to 1 behind one proxy. Too high a number
# lets a visitor claim any address; too low only means everyone appears to come from the proxy.
# TRUST_PROXY=1

# How long "remember me" keeps someone signed in. Without it a session lasts 12 hours.
# SESSION_DAYS=30

# First-run setup asks for this code. Required in production (without it, setup is switched
# off). Choose a long random value, at least 16 characters, and remove it once setup is done.
# SETUP_CODE=
